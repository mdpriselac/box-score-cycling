  "usage_instructions": {
    "join_pattern": "\n            -- Join with race features for complete data\n            SELECT \n                rkf.*,\n                COALESCE(rf70.race_name, rf40.race_name) as race_name,\n                COALESCE(rf70.competition_name, rf40.competition_name) as competition_name,\n                COALESCE(rf70.competition_type, rf40.competition_type) as competition_type,\n                COALESCE(rf70.race_category, rf40.race_category) as race_category\n            FROM race_kind_features_unified_test rkf\n            LEFT JOIN race_features_70 rf70 ON rkf.competition_id = rf70.competition_id\n            LEFT JOIN race_features_40 rf40 ON rkf.competition_id = rf40.competition_id\n            WHERE rf70.competition_id IS NOT NULL OR rf40.competition_id IS NOT NULL\n            ",
    "key_features": [
      "cluster_label: Primary cluster assignment",
      "cluster_0, cluster_1, cluster_2, cluster_3: One-hot encoded cluster membership",
      "distance_to_cluster_0, distance_to_cluster_1, etc.: Distance to each cluster center",
      "local_density: How typical the race is within its cluster",
      "boundary_distance: Distance to nearest different cluster"
    ],
    "competition_type_models": {
      "one_day": "Uses hierarchical 40th percentile model",
      "stage": "Uses hierarchical 40th percentile model",
      "gc": "Uses hierarchical 70th percentile model"
    }
  },
