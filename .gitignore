# Byte-compiled / optimized / DLL files
**/__pycache__/
__pycache__/
*.py[cod]
*$py.class
./DS_Store
**/.DS_Store
# LibreOffice/Office lock files — stale editor artifacts that record the
# local user, host and open path.
.~lock.*#
# C extensions
*.so

# log files ignore in any and all folders
**/*.log
*.log
# Database
cycling_project/webscrape_tools/database/database/cycling_races.db
cycling_project/webscrape_tools/database/database/cycling_races*.db
cycling_project/webscrape_tools/database/database/cycling_races*.db*

