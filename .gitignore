# Log directories
**/webscrape_logs/

# Git artifacts
.git-rewrite/

# Streamlit secrets
.streamlit/secrets.toml

# Model history (archived models)
models/history/
models/production_backup_*/

# Performance evals — the capture scripts, model predictions, odds captures,
# results and betting reports are all tracked, so the netlify pages rebuild
# from a clean clone. Raw third-party captures stay local: they are kept only
# for provenance, are bulky, and are re-fetchable from source. Our own
# *_bets.html reports are tracked — only saved vendor pages are excluded.
performance_eval/**/stage_page_*.html
performance_eval/**/race_page_*.html
performance_eval/**/*FirstCycling*.html
performance_eval/**/odds/**/raw/
# The blanket *.csv rule above would otherwise swallow the results and odds
# tables that the build scripts read.
!performance_eval/**/*.csv
# Database backups (multi-GB copies)
cycling_project/webscrape_tools/database/backups/

# Claude Code worktrees
.claude/worktrees/

# Experiment record dumps / lab caches (large; JSONs are the tracked artifact)
experiments/*.csv.gz

# Day-menu kernel cumulants: 100MB+ derived artifact, rebuilt DB-fresh at
# every production train (train_production_model day-menu block)
models/production/day_menu_kernels.parquet

# wrangler dev caches and stale deploy archives
.wrangler/
netlify_site/.wrangler/
netlify_site/Archive.zip

# nightly release bundles and slices (built by cycling_project/nightly/weekly_release.py)
performance_eval/runs/releases/
*.inference_slice.db
inference_slice.db

# Supabase CLI local state and private signing keys (never commit)
supabase/.temp/
supabase/.branches/
supabase/signing_keys.json
supabase/**/signing_keys*.json

# test fixtures may legitimately contain CSV archives
!cycling_project/tests/fixtures/**/*.csv
