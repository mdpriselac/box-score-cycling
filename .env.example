# Copy to .env (or ~/.config/cycling-project/secrets.env for secrets) and fill in your own values.
# Nothing here is needed to run the tests.

# Local data
SCRAPED_DATA_DIR=~/cycling_data/scraped_data

# Supabase control plane (nightly runs, keys, operator inbox)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_NIGHTLY_KEY=
SUPABASE_RELEASE_READER_KEY=
# Operator only: never put this in an agent vault, prompt or log.
SUPABASE_SECRET_KEY=

# Claude Managed Agents (or use an `ant auth login` profile)
ANTHROPIC_API_KEY=

# Cloudflare Pages, for publishing the site
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Operator notifications
NTFY_TOPIC=
